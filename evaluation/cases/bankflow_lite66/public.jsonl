{"id": "context_u01", "title": "修改一笔转账并重算剩余比例", "domain": "跨业务协作与统一资金", "difficulty": "expert", "family": "lite66_context_u01", "turns": [{"kind": "chat", "label": "initial", "text": "给妈妈转400元，给小王转1500元，剩余资金的20%用于ETF资料比较，先核对计划等我确认。", "category": "", "action": "", "params": {}, "user": "demo", "save": "", "source": ""}, {"kind": "chat", "label": "modified", "text": "只把给小王的那笔改成800元，妈妈400元不变，ETF仍按两笔转账后的剩余资金20%查资料。", "category": "", "action": "", "params": {}, "user": "demo", "save": "", "source": ""}]}
