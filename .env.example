BANK_MODEL_MODE=demo
BANK_ORCHESTRATION_MODE=supervisor
BANK_AGENT_RUNTIME=agents_sdk
BANK_MEMORY_BACKEND=chroma
# Empty: local single-process index. Multi-worker deployments use a Chroma server.
BANK_CHROMA_URL=
BANK_MODEL_BASE_URL=https://api.deepseek.com
BANK_MODEL_NAME=deepseek-flash
BANK_MODEL_API_KEY=
# Optional business providers. Keys stay on the server; no judge-key fallback.
# Users can also enter their own keys and choose models in the model picker.
BANK_GLM_API_KEY=
BANK_GLM_MODEL=glm-5.3
BANK_MIMO_API_KEY=
BANK_MIMO_MODEL=mimo-v2.6-pro
BANK_KIMI_API_KEY=
BANK_KIMI_MODEL=kimi-k3.1-pro
BANK_QWEN_API_KEY=
BANK_QWEN_MODEL=qwen3.8-max
BANK_MINIMAX_API_KEY=
BANK_MINIMAX_MODEL=MiniMax-M3.1-Flash
# Each provider also accepts BANK_<PROVIDER>_BASE_URL and _CONTEXT_TOKENS.
# Configure the account's region-specific Qwen endpoint when required.
BANK_MODEL_THINKING=true
BANK_MODEL_REASONING_EFFORT=max
BANK_MODEL_MAX_TOKENS=16384
# Configured context capacity; includes full prompt + output reserve + margin.
BANK_MODEL_CONTEXT_TOKENS=131072
BANK_MODEL_TOKEN_SAFETY_MARGIN=2048
# Shared cumulative budget for roles using the same trusted task_id.
BANK_TASK_TOKEN_BUDGET=1048576
BANK_MODEL_TIMEOUT=120
BANK_DATA_DIR=.data
BANK_DEMO_ENABLED=true
BANK_DEMO_VERIFICATION_ENABLED=true
BANK_BIND_HOST=127.0.0.1
BANK_BIND_PORT=8000
BANK_MEMORY_EMBEDDING=lexical
# Use fastembed after preparing the BGE model cache.
BANK_MEMORY_MODEL=BAAI/bge-small-zh-v1.5
BANK_MEMORY_TOP_K=6
BANK_MEMORY_CONTEXT_CHARS=6000
BANK_MEMORY_MAINTENANCE_ENABLED=true
BANK_MEMORY_MAINTENANCE_INTERVAL=60
BANK_MEMORY_MAINTENANCE_BATCH=64
BANK_MEMORY_ACTIVE_DIALOGUES=128
BANK_MAX_REPLANS=3
BANK_RESEARCH_MAX_ROUNDS=2
BANK_RESEARCH_CONCURRENCY=3
BANK_RESEARCH_QUEUE_LIMIT=100
BANK_RESEARCH_TIMEOUT=300
BANK_MEMORY_STRATEGY=compressed
BANK_SCHEDULER_MODE=embedded
BANK_SCHEDULER_INTERVAL=15
BANK_WEB_WORKERS=1
BANK_CHAT_WORKER_MODE=embedded
BANK_CHAT_CONCURRENCY=3
BANK_CHAT_QUEUE_LIMIT=100
BANK_CHAT_LEASE_SECONDS=30

# Independent evaluation judge; never replaces BANK_MODEL_*.
BANK_JUDGE_PROVIDER=mimo
BANK_JUDGE_BASE_URL=https://api.xiaomimimo.com/v1
BANK_JUDGE_MODEL=mimo-v2.6-pro
BANK_JUDGE_API_KEY=
BANK_JUDGE_THINKING=true
BANK_JUDGE_MAX_COMPLETION_TOKENS=8192
BANK_JUDGE_TIMEOUT=120
BANK_JUDGE_FORMAT_RETRIES=1
BANK_JUDGE_RPM=20
BANK_JUDGE_CONCURRENCY=2

